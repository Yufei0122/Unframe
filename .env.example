# Server only. Copy to .env; never put credentials in EXPO_PUBLIC_* variables.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini 3.8 Flash supports global/us/eu; embedding uses its own regional endpoint.
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
VERTEX_MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001
ARTWORK_MATCH_THRESHOLD=0.80
# Optional. Defaults to data/artwork-embeddings.json
# ARTWORK_EMBEDDINGS_FILE=
# Prefer: gcloud auth application-default login (no key file needed).
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/service-account.json
AI_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://127.0.0.1:8091
