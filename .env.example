# Local defaults. Cloud adapters are opt-in; never put AWS keys in this file.
# AI_PROVIDER=ollama
# VECTOR_STORE=local
# AWS_REGION=ap-southeast-2
# BEDROCK_MODEL_ID=google.gemma-3-12b-it
# BEDROCK_PLANNING_MODEL_ID=google.gemma-3-12b-it
# BEDROCK_VISION_MODEL_ID=google.gemma-3-12b-it
# BEDROCK_TIMEOUT_MS=120000
# S3_VECTOR_INDEX_ARN=<existing-index-arn>
# S3_VECTOR_VERSION=openclip-v1
# JOBS_TABLE_NAME=<existing-table-name>
# JOB_IMAGES_BUCKET=<temporary-images-bucket>
# JOB_IMAGE_PREFIX=uploads/
# JOBS_ALLOWED_ORIGINS=https://your-frontend.example
# JOB_UPLOAD_TTL_SECONDS=300
# JOB_TTL_SECONDS=86400
# RECOGNITION_QUEUE_URL=<existing-queue-url>
# WORKER_VISIBILITY_SECONDS=300
# WORKER_JOB_TIMEOUT_MS=180000
# WORKER_MAX_ATTEMPTS=5
# See docs/aws-deployment-readiness.md before enabling cloud adapters.
# PORT=3000
# Browser visits to the backend root redirect to the Expo mobile preview.
# MOBILE_WEB_URL=http://localhost:8081
OPENCLIP_URL=http://127.0.0.1:8001
OPENCLIP_DEVICE=cpu
OPENCLIP_THREADS=1
OPENCLIP_TIMEOUT_MS=4500
OLLAMA_URL=http://127.0.0.1:11434
# Catalogue explanation selects verified notes, sharing the warm text model with planning.
OLLAMA_MODEL=qwen3:1.7b
# Route preference understanding shares the lightweight model by default.
OLLAMA_PLANNING_MODEL=qwen3:1.7b
# General image analysis is separate from the text-only guide model.
# Instruct avoids the long reasoning of the legacy Thinking model tags.
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
# Includes first load on CPU; independent of short text-answer limits.
OLLAMA_VISION_TIMEOUT_MS=120000
OLLAMA_VISION_NUM_PREDICT=768
OLLAMA_VISION_NUM_CTX=4096
AI_ANALYSIS_BUDGET_MS=125000
EXPO_PUBLIC_VISION_TIMEOUT_MS=130000
OLLAMA_EXPLANATION_TIMEOUT_MS=45000
EXPO_PUBLIC_AI_TIMEOUT_MS=50000
# Sends only proposed artwork titles/artists to public catalogue APIs, never photos.
ARTWORK_PUBLIC_SEARCH=true
# Status/preflight budget; feature deadlines above are independent.
AI_RESPONSE_BUDGET_MS=15000
AI_RECOGNITION_BUDGET_MS=5000
OLLAMA_TIMEOUT_MS=14000
OLLAMA_NUM_CTX=2048
# -1 lets Ollama place as many layers as possible on an available GPU; it falls back to CPU.
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_PREDICT=256
# Full planning JSON plus a short reply; this is a maximum, not a target length.
OLLAMA_PLANNING_NUM_PREDICT=1024
OLLAMA_PLANNING_NUM_CTX=4096
# Keep the text model warm so route requests do not pay model-load time.
OLLAMA_KEEP_ALIVE=10m
# Optional local model cache and installer cache live under .local-ai by default.
# OPENCLIP_CACHE_DIR=
# Cosine similarity, not probability. Validate against your own camera samples.
ARTWORK_MATCH_THRESHOLD=0.80
# Optional. Defaults to data/artwork-embeddings.json
# ARTWORK_EMBEDDINGS_FILE=
AI_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://127.0.0.1:8091
# Planning/confirmation Lambda (buffered NDJSON, HTTP API integration timeout 30000 ms):
# PLANNING_API_TIMEOUT_MS=25000
# AI_ALLOWED_ORIGINS=https://<frontend-domain>
