# Public Expo settings only. Copy needed entries to .env.local and restart Expo.
# Web on localhost resolves the Node backend at port 3000 automatically.
# A phone needs a backend URL reachable from that phone, not phone localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# CPU inference deadlines in milliseconds; keep above the Node service deadlines.
EXPO_PUBLIC_AI_TIMEOUT_MS=330000
EXPO_PUBLIC_CLIP_TIMEOUT_MS=150000
