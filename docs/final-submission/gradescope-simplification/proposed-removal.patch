+    analysisMessage: serviceStatus.vision?.available ? 'General visual analysis is available. Public reference search needs internet access; identities remain unconfirmed.' : 'General visual analysis needs a local vision model. Run npm.cmd run ai:setup:vision, then ai:doctor -- --vision.',
+    configuration: { valid: true, provider: 'local', ollamaModel: config.ollamaModel, embeddingModel: config.embeddingModel, embeddingPretrained: config.embeddingPretrained, dimension: config.dimension, visionModel: config.visionModel, analysisVersion: ARTWORK_ANALYSIS_VERSION, recognitionVersion: RECOGNITION_VERSION, visionTimeoutMs: config.visionTimeoutMs, visionNumPredict: config.visionNumPredict, visionNumCtx: config.visionNumCtx, analysisBudgetMs: config.analysisBudgetMs, explanationTimeoutMs: config.explanationTimeoutMs, recognitionBudgetMs: config.recognitionBudgetMs, responseBudgetMs: config.responseBudgetMs },
+    catalogueHash: referenceCatalogueHash(), services: serviceStatus, index,
